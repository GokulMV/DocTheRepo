  "cards": [
    {
      "dot": "cyan",
      "title": "Visibility",
      "items": [
        "Knowledge chunks have no repo, so every viewer can read them in Q&A",
        "Pages link to mentioned services, repos and endpoints (documented_in / runbook_for)"
      ]
    },
    {
      "dot": "amber",
      "title": "Known issues from upstream",
      "items": [
        "Docs with the known-issue label become disabled draft rules (match proposed by the suggest route)",
        "The upstream check runs on every synced page: a Jira issue moving to Done flips a suppressing rule to label-only"
      ]
    },
    {
      "dot": "slate",
      "title": "Housekeeping",
      "items": [
        "Daily reconcile removes pages deleted upstream",
        "POST /known-issues/from-link fetches a URL through the owning connector",
        "Spend-blocked embedding keeps docs keyword-searchable"
      ]
    }
