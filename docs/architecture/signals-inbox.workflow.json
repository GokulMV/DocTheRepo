  "cards": [
    {
      "dot": "rose",
      "title": "Never-send-to-LLM",
      "items": [
        "Events from a connector set to never send data to a model get attr dth.no_llm=true at ingest",
        "Their issue is never decoded, even when a user forces a decode — policy, not cost"
      ]
    },
    {
      "dot": "amber",
      "title": "Known issues",
      "items": [
        "Suppressed events still group and count, but are not decoded unless forced",
        "Daily auto-suggestions and paste-text proposals create rules a human enables"
      ]
    },
    {
      "dot": "cyan",
      "title": "Decode context",
      "items": [
        "Redacted samples, frame → code, docs, commits from the last 7 days, similar issues, runbooks",
        "Every decode is indexed so later issues find it as similar"
      ]
    }
  ]
