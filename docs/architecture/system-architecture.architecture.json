  "cards": [
    {
      "dot": "cyan",
      "title": "One binary, three roles",
      "items": [
        "Local: all roles in one process; prod: api, worker, scheduler as separate services",
        "The job queue is a Postgres table claimed with FOR UPDATE SKIP LOCKED"
      ]
    },
    {
      "dot": "emerald",
      "title": "Ports and adapters",
      "items": [
        "Core depends only on internal/ports interfaces",
        "cmd/hub/wire.go is the composition root"
      ]
    },
    {
      "dot": "rose",
      "title": "Spend + secrets",
      "items": [
        "Every paid model call goes through llmgateway + spendguard",
        "Connector creds and provider keys are AES-GCM envelope-encrypted (local, AWS KMS, GCP KMS)"
      ]
    }
  ]
