  "cards": [
    {
      "dot": "emerald",
      "title": "Cost control",
      "items": [
        "Triage aborts cosmetic pushes before any paid call (savings recorded)",
        "Docgen, triage and embedding all go through the LLM gateway and spend guard",
        "A spend-blocked embedding leaves chunks text-searchable until reindex"
      ]
    },
    {
      "dot": "cyan",
      "title": "Landing",
      "items": [
        "Docs land per repo push mode: direct commit, PR with auto-merge, or PR with approver",
        "Open docs PRs are tracked by the PR lifecycle sweeper"
      ]
    },
    {
      "dot": "violet",
      "title": "Index",
      "items": [
        "Generated docs are chunks too, so Q&A retrieves them beside the code",
        "last_processed_sha is advanced only after persist succeeds"
      ]
    }
  ]
