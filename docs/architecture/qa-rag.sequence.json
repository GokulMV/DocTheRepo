    {
      "dot": "emerald",
      "title": "Retrieval",
      "items": [
        "Vector search and Postgres full-text search, fused with Reciprocal Rank Fusion",
        "Top code chunks expand one hop to callers / callees",
        "Every store read is scoped to the caller's repository ACL"
      ]
    },
    {
      "dot": "rose",
      "title": "Answer contract",
      "items": [
        "The model may cite only chunks it was given; others are dropped",
        "No packed sources → a fixed not-found answer, no model call"
      ]
    },
    {
      "dot": "cyan",
      "title": "Cache",
      "items": [
        "Key = normalized question + scope + index version",
        "Follow-up questions (with history) skip the cache; hits record savings"
      ]
    }
  ]
